{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "STZ XML Translator",
  "version": "1.7.0",
  "identifier": "com.stzlabs.xmltranslator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "STZ XML Translator",
        "width": 1360,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 620,
        "resizable": true,
        "backgroundColor": "#0E1014",
        "center": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "stz-xml-translator"
}
